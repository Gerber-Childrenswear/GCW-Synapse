{
  "name": "gcw-synapse",
  "version": "1.0.0",
  "description": "Data Engine replacement for Elevar",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "replay:webhook:create": "tsx scripts/replayWebhook.ts orders/create",
    "replay:webhook:paid": "tsx scripts/replayWebhook.ts orders/paid"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gerber-Childrenswear/GCW-Synapse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Gerber-Childrenswear/GCW-Synapse/issues"
  },
  "homepage": "https://github.com/Gerber-Childrenswear/GCW-Synapse#readme",
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
