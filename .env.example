NODE_ENV=development
RUNTIME_MODE=forward
PORT=4000
GTM_SERVER_URL=https://your-server-gtm-endpoint.example.com/g/collect
# GCW-Synapse Shopify app (Partners client id)
SHOPIFY_API_KEY=7d011b70562512bd84b85bd3f9a6e68d
SHOPIFY_API_SECRET=replace_with_shopify_app_client_secret
SHOPIFY_APP_URL=https://gcw-synapse.ncassidy.workers.dev
SHOPIFY_APP_SCOPES=read_orders
SHOPIFY_AUTH_CALLBACK_PATH=/auth/shopify/callback
# For app-owned webhooks, use the same value as SHOPIFY_API_SECRET
SHOPIFY_WEBHOOK_SECRET=replace_with_shopify_app_client_secret
WEBHOOK_PATH_PREFIX=/webhooks/shopify/orders
REQUEST_TIMEOUT_MS=10000
GTM_FORWARD_MAX_RETRIES=2
GTM_FORWARD_BACKOFF_MS=300
IDEMPOTENCY_TTL_MS=600000
ALLOWED_WEBHOOK_TOPICS=orders/create,orders/paid
CUSTOMER_ID_FALLBACK=guest
SHOP_DEFAULT_CURRENCY=USD
FACEBOOK_PIXEL_ID=123456789012345
PINTEREST_ID=2612345678901
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Shadow compare mode options (used when RUNTIME_MODE=shadow_compare)
SHADOW_COMPARE_MAX_RECORDS=5000
SHADOW_COMPARE_MISMATCH_ALERT_PCT=5
# SHADOW_COMPARE_STORE_PATH=./data/shadow-compare.jsonl
CHANNEL_HEALTH_STALE_MINUTES=90
CHANNEL_HEALTH_WARN_FAILURE_PCT=5
LAUNCH_MIN_PAIRED_EVENTS=100
LAUNCH_MAX_WARNING_CHANNELS=0
LAUNCH_MAX_WEBHOOK_FAILURE_RATE_PCT=2
# Optional per-shop overrides: shop-domain=measurement-id,shop-domain=measurement-id
# GA4_MEASUREMENT_ID_BY_SHOP=store-a.myshopify.com=G-AAAA1111,store-b.myshopify.com=G-BBBB2222
# Optional: require this header on non-Shopify ingress routes like /diagnostics, /event, and /compare/*
# X-Synapse-Token: <token>
# INGRESS_SHARED_TOKEN=replace_with_secure_token

# --- Cloudflare / gcw-dev deploy ---
# Express runs on Workers via nodejs_compat (see worker/src/index.ts).
# Non-secret defaults live in wrangler.jsonc (RUNTIME_MODE=shadow_compare, SHOPIFY_API_KEY).
# Put secrets with wrangler:
#   npx wrangler secret put GTM_SERVER_URL
#   npx wrangler secret put SHOPIFY_API_SECRET
#   npx wrangler secret put SHOPIFY_WEBHOOK_SECRET
#   npx wrangler secret put INGRESS_SHARED_TOKEN
# Local Cloudflare secret mirror (never commit):
#   Copy-Item .dev.vars.example .dev.vars
