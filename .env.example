NODE_ENV=development
RUNTIME_MODE=forward
PORT=4000
# Shopify internal app credentials and config.
# Keep these in your secrets manager or local .env, not in git.
SHOPIFY_API_KEY=replace_with_shopify_app_client_id
SHOPIFY_API_SECRET=replace_with_shopify_app_secret
SHOPIFY_APP_URL=https://your-admin-app.example.com
SHOPIFY_APP_SCOPES=read_products,read_orders,write_products
SHOPIFY_AUTH_CALLBACK_PATH=/auth/shopify/callback
# SHOPIFY_TOKEN_STORE_PATH=./data/shopify-tokens.json
GTM_SERVER_URL=https://your-server-gtm-endpoint.example.com/g/collect
SHOPIFY_WEBHOOK_SECRET=replace_with_shopify_webhook_secret
WEBHOOK_PATH_PREFIX=/webhooks/shopify/orders
REFUNDS_WEBHOOK_PATH_PREFIX=/webhooks/shopify/refunds
JSON_BODY_LIMIT=256kb
REQUEST_TIMEOUT_MS=10000
# Optional outbound signing secret used for Synapse -> GTM HMAC headers.
# If set, requests include X-Synapse-Timestamp and X-Synapse-Signature.
# GTM receiver should verify HMAC_SHA256(secret, `${timestamp}.${rawBody}`).
# GTM_FORWARD_SHARED_SECRET=replace_with_long_random_secret
# Optional JSONL dead-letter path for terminal GTM forward failures.
# GTM_DEAD_LETTER_PATH=./data/gtm-dead-letter.jsonl
# Replay commands:
# npm run replay:dead-letter:dry
# npm run replay:dead-letter -- --limit 50
GTM_FORWARD_MAX_RETRIES=2
GTM_FORWARD_BACKOFF_MS=300
IDEMPOTENCY_TTL_MS=600000
ALLOWED_WEBHOOK_TOPICS=orders/create,orders/paid,refunds/create
CUSTOMER_ID_FALLBACK=guest
SHOP_DEFAULT_CURRENCY=USD
FACEBOOK_PIXEL_ID=123456789012345
PINTEREST_ID=2612345678901
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Shadow compare mode options (used when RUNTIME_MODE=shadow_compare)
SHADOW_COMPARE_MAX_RECORDS=5000
SHADOW_COMPARE_MISMATCH_ALERT_PCT=5
# SHADOW_COMPARE_STORE_PATH=./data/shadow-compare.jsonl
CHANNEL_HEALTH_STALE_MINUTES=90
CHANNEL_HEALTH_WARN_FAILURE_PCT=5
LAUNCH_MIN_PAIRED_EVENTS=100
LAUNCH_MAX_WARNING_CHANNELS=0
LAUNCH_MAX_WEBHOOK_FAILURE_RATE_PCT=2
# Launch guard: block app startup when critical launch risks are detected.
STRICT_LAUNCH_GUARD=false
LAUNCH_MAX_DEAD_LETTER_RECORDS=0
LAUNCH_THEME_AUDIT_PATH=docs/gtm/THEME_TRACKING_AUDIT.md
LAUNCH_BLOCK_ON_THEME_CONFLICTS=true
# Optional per-shop overrides: shop-domain=measurement-id,shop-domain=measurement-id
# GA4_MEASUREMENT_ID_BY_SHOP=store-a.myshopify.com=G-AAAA1111,store-b.myshopify.com=G-BBBB2222
# Optional: require this header on non-Shopify ingress routes like /diagnostics, /event, and /compare/*
# X-Synapse-Token: <token>
# INGRESS_SHARED_TOKEN=replace_with_secure_token
# Comma-separated list of allowed CORS origins for the public /event endpoint.
# Leave unset to allow all origins (open); set for production to restrict to your storefront.
# PUBLIC_EVENT_ALLOWED_ORIGINS=https://www.gerberchildrenswear.com,https://gerberchildrenswear.myshopify.com
# Max events per minute per IP on the public /event endpoint (default 120).
# PUBLIC_EVENT_RATE_LIMIT_PER_MINUTE=120
# Graceful shutdown drain timeout in ms (default 10000).
# SHUTDOWN_TIMEOUT_MS=10000
# Local in-app advisor using a local model runtime (for example Ollama).
LOCAL_ADVISOR_ENABLED=false
LOCAL_ADVISOR_BASE_URL=http://127.0.0.1:11434
LOCAL_ADVISOR_MODEL=qwen2.5:14b-instruct
LOCAL_ADVISOR_TIMEOUT_MS=30000
