# Optional: self-hosted GTM MCP with service account (local / CI).
# Hosted OAuth MCP (default in .cursor/mcp.json) does not need these.

# Absolute path to Google service account JSON with GTM Account Administrator on
# accounts 4131312986 (web) and 6348717123 (server).
GTM_SA_KEY_PATH=/absolute/path/to/gtm-service-account.json

# Used by paolobietolini/gtm-mcp-server self-hosted mode only:
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=<paste JSON or use file path above>
# SERVICE_ACCOUNT_API_KEY=<openssl rand -hex 32>
